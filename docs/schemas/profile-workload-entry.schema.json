{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinicjs.org/schemas/profile-workload-entry.schema.json",
  "title": "Clinic.js profile workload entry",
  "type": "object",
  "required": ["executable", "argv", "cwd", "env_allowlist", "profilers", "limits", "network", "parameters", "throughput", "input_mounts"],
  "additionalProperties": false,
  "properties": {
    "executable": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cwd": {"type": "string", "pattern": "^/workspace(?:/[A-Za-z0-9_-]+)*$"},
    "env_allowlist": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "uniqueItems": true},
    "profilers": {"type": "array", "const": ["clinic-flame"]},
    "limits": {
      "type": "object",
      "required": ["wall_clock_ms", "cpu_ms", "memory_mb", "artifact_mb"],
      "additionalProperties": false,
      "properties": {
        "wall_clock_ms": {"type": "integer", "minimum": 1},
        "cpu_ms": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 1},
        "artifact_mb": {"type": "integer", "minimum": 1}
      }
    },
    "network": {"const": "disabled"},
    "input_mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_root", "source", "target", "digest"],
        "additionalProperties": false,
        "properties": {
          "source_root": {"enum": ["workspace", "declared-input"]},
          "source": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"},
          "target": {"type": "string", "pattern": "^/inputs/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"},
          "digest": {"type": "string", "pattern": "^sha256-[a-f0-9]{64}$"}
        }
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["type", "min", "max", "binding"],
        "additionalProperties": false,
        "properties": {
          "type": {"const": "integer"},
          "min": {"type": "integer"},
          "max": {"type": "integer"},
          "binding": {
            "type": "object",
            "required": ["kind", "index"],
            "additionalProperties": false,
            "properties": {
              "kind": {"const": "argv"},
              "index": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "throughput": {
      "type": "object",
      "required": ["unit", "definition"],
      "additionalProperties": false,
      "properties": {
        "unit": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    }
  }
}
